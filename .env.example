# Copy to .env and fill in. Never commit .env.

# --- Upstream provider ---
# Any OpenAI-compatible API. Default is Groq's free tier (key: console.groq.com/keys).
# OpenAI: https://api.openai.com/v1 (then set OpenAI model IDs in routing.json)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Used when the calling app doesn't send its own key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Failover (optional) ---
# Keys for backup providers listed under "fallbacks" in routing.json, e.g. Gemini:
GEMINI_API_KEY=

# --- Security ---
# Per-team proxy keys: team:key,team:key (keys 16+ chars). Generate one with:
#   python3 -c "import secrets; print('k_' + secrets.token_urlsafe(24))"
# When set, callers must send X-Cost-Guard-Key and their team comes from the key.
# Leave empty only for local development.
COST_GUARD_KEYS=
# Password for the dashboard and /stats (user: DASHBOARD_USER, default admin)
DASHBOARD_PASSWORD=
DASHBOARD_USER=admin
# Reject request bodies larger than this (bytes)
MAX_BODY_BYTES=1000000

# --- Budgets ---
# Daily USD limit per team; calls get HTTP 429 once reached. e.g. search:5,support:2.50
BUDGETS=
# Output tokens assumed for the pre-call budget check when a request sets no limit
DEFAULT_OUTPUT_ESTIMATE=1024

# --- Cache ---
# deterministic (cache only temperature=0 calls) | all | off
CACHE_MODE=deterministic
CACHE_TTL_SECONDS=86400
UPSTREAM_TIMEOUT=120

# --- Observability ---
# Protect /metrics with a bearer token (Prometheus config must send it)
METRICS_TOKEN=
# Send OpenTelemetry traces. With the observability profile: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana admin password (the dashboard itself is viewable without logging in, on localhost only)
GRAFANA_ADMIN_PASSWORD=change-me
