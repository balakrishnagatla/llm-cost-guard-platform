{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "llm-cost-guard values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "openaiBaseUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "anthropicBaseUrl": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "OPENAI_API_KEY",
              "ANTHROPIC_API_KEY",
              "GEMINI_API_KEY",
              "COST_GUARD_KEYS",
              "DASHBOARD_PASSWORD",
              "METRICS_TOKEN"
            ]
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "budgets": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_.-]+:[0-9.]+(,[A-Za-z0-9_.-]+:[0-9.]+)*$"
        },
        "cacheMode": {
          "enum": [
            "deterministic",
            "all",
            "off"
          ]
        },
        "cacheTtlSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "upstreamTimeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "defaultOutputEstimate": {
          "type": "integer",
          "minimum": 1
        },
        "logFormat": {
          "enum": [
            "json",
            "text"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "routing": {
      "type": "object"
    },
    "pricing": {
      "type": "object"
    },
    "otel": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "serviceName": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod",
            "ReadWriteMany"
          ]
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "restrictEgress": {
          "type": "boolean"
        },
        "egressPorts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "ingressFrom": {
          "type": "array"
        }
      }
    },
    "mockProvider": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failRate": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
        }
      }
    },
    "experimental": {
      "type": "object",
      "properties": {
        "allowMultipleReplicas": {
          "type": "boolean"
        }
      }
    }
  }
}
